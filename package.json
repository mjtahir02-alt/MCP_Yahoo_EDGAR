{
  "name": "market-filings-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Skybridge MCP connector for Yahoo Finance market data and SEC EDGAR filings",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "skybridge build",
    "start": "skybridge start",
    "deploy": "alpic deploy",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm run build && npm run smoke:offline",
    "smoke:offline": "tsx scripts/offline-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "skybridge": "^1.2.7",
    "vite": "^8.0.3",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@skybridge/devtools": "^1.1.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "alpic": "^1.136.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
